+def main_entry_span(msl):
+    """Return the ordinary fragment entry point, excluding appended entry variants such as main0_u."""
+    m = re.search(r'\bfragment\s+main0_out\s+main0\s*\(', msl)
+    if not m: return None
+    brace = msl.find('{', m.end())
+    if brace < 0: return None
+    depth = 0
+    for end in range(brace, len(msl)):
+        depth += msl[end] == '{'; depth -= msl[end] == '}'
+        if depth == 0: return m.start(), end + 1
+    return None
